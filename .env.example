DATABASE_URL=postgresql://taskmgr:taskmgr@localhost:5432/taskmgr

# Auth — required for sign-in (generate with: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string

# SMTP — required to send OTP emails
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your-smtp-user
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM="Impact Wall <noreply@example.com>"

# OpenAI — optional; powers hourly team jokes during office hours (10 AM – 6 PM)
OPENAI_API_KEY=

# Weekly reports — secret for cron POST /api/reports/generate (generate with: openssl rand -hex 32)
REPORTS_CRON_SECRET=

# App URL — used by external cron curl (e.g. https://wall.yourdomain.com)
APP_URL=http://localhost:3000
